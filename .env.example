# CARLA simulator paths
CARLA_PATH=/path/to/carla
USERNAME=your_linux_username
CONDA_PATH=/home/your_linux_username/anaconda3
OUTPUT_PATH=/home/your_linux_username/untitled/output

# CARLA simulator ports 
CARLA_PORT=2000
CARLA_TRAFFIC_MANAGER_PORT=2050

# Paths of secret files
HOSTS_PATH=/path/to/hosts.yaml
